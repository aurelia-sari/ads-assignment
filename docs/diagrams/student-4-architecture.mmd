graph LR
    subgraph FE["student-4-frontend (nginx :8084)"]
        SIGNUP["signup.html<br/>name / email / password / T&amp;C"]
        VERIFY["verify-pending.html<br/>resend countdown"]
        IDX["index.html<br/>Guides tab / AI Assistant tab"]
    end

    subgraph API["student-4-api (Flask :5104)"]
        REG["POST /auth/register"]
        RESEND["POST /auth/resend"]
        VER["GET /auth/verify/&lt;token&gt;<br/>renders confirm/expired/invalid page"]
        GUIDES["GET /guides?query=<br/>list/search fragment"]
        DETAIL["GET /guides/&lt;id&gt;<br/>detail fragment: Currency,<br/>Transportation, Visa, Weather, Safety"]
        SUBS["GET /guides/&lt;id&gt;/currency<br/>/transportation?type=<br/>/visa?nationality=<br/>/weather?month=<br/>/safety"]
        MAIL["send_verification_email()<br/>smtplib"]
    end

    subgraph DB4["student-4-db (Flask + SQLite :5204)"]
        DEST[("destinations<br/>13 seed rows")]
        CUR[("currency_infos<br/>13 seed rows")]
        TRA[("transportation_infos<br/>51 seed rows")]
        VIS[("visa_requirements<br/>104 seed rows")]
        WEA[("weather_infos<br/>156 seed rows")]
        SAF[("safety_infos<br/>13 seed rows")]
    end

    subgraph SHARED["shared-api :5000 -> shared-db :5200<br/>owns users, access_logs, travellers"]
        USR[("users<br/>10 seed rows")]
        LOG[("access_logs<br/>10 seed rows")]
        TRV[("travellers<br/>12 rows")]
    end

    MP["mailpit<br/>:1025 SMTP / :8025 web UI"]
    S5["student-5-frontend :8085<br/>#search (flights)"]

    SIGNUP -->|"fetch POST, JSON"| REG
    VERIFY -->|"fetch POST, JSON"| RESEND
    IDX -->|"hx-get, form submit"| GUIDES
    IDX -->|"hx-get on row/tab click"| DETAIL
    DETAIL -->|"hx-get on tab click"| SUBS
    DETAIL -->|"Book flights button"| S5

    REG -->|"HTTP JSON: create user,<br/>token + 5 min expiry"| SHARED
    RESEND -->|"HTTP JSON: rate-limit check<br/>(60s / 5 attempts / 10 min block)"| SHARED
    VER -->|"HTTP JSON: verify token"| SHARED
    GUIDES -->|"HTTP JSON: search"| DB4
    DETAIL -->|"HTTP JSON: read"| DB4
    SUBS -->|"HTTP JSON: read"| DB4

    REG --> MAIL
    RESEND --> MAIL
    MAIL -->|"SMTP"| MP

    SHARED --- USR
    SHARED --- LOG
    SHARED --- TRV
    DB4 --- DEST
    DB4 --- CUR
    DB4 --- TRA
    DB4 --- VIS
    DB4 --- WEA
    DB4 --- SAF
