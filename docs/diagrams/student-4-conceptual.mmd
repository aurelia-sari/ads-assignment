%% student-4 - Conceptual data model.
%% Entities and relationships only. No attributes, no keys, no types - those
%% belong to the logical and physical models.

graph LR
    U["USER<br/><i>who holds an account</i>"]
    L["ACCESS LOG<br/><i>when they signed in and out</i>"]

    U -->|"generates<br/>1 : many"| L

    subgraph Boundary["owned by shared-db, not student-4-db"]
        U
        L
    end

    D["DESTINATION<br/><i>a city a guide exists for</i>"]
    C["CURRENCY INFO<br/><i>what money is used there</i>"]
    T["TRANSPORTATION INFO<br/><i>how to get around, by mode</i>"]
    V["VISA REQUIREMENT<br/><i>entry rules, by nationality</i>"]
    W["WEATHER INFO<br/><i>climate, by month</i>"]
    S["SAFETY INFO<br/><i>advisory level and local tips</i>"]

    D -->|"priced in<br/>1 : 1"| C
    D -->|"reachable by<br/>1 : many"| T
    D -->|"entered under<br/>1 : many"| V
    D -->|"experiences<br/>1 : many"| W
    D -->|"rated for<br/>1 : 1"| S

    subgraph Guides["owned by student-4-db, backs the Travel Guides page"]
        D
        C
        T
        V
        W
        S
    end
