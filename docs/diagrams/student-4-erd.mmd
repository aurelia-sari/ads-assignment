%% student-4 (Aurelia Sari) - Account & Dashboard
%% Entity-relationship diagram.
%%
%% USER and ACCESS_LOG are owned by shared-db, not student-4-db: a user's id
%% and sign-in state may be needed in every feature. The
%% relationship is enforced in SQLite, both tables live together in
%% shared.db, not split across service boundaries.
%%
%% DESTINATION and the five info tables below it are owned by student-4-db.
%% They back the Travel Guides page: every destination is an Australian city
%% (seeded from the same cities used as flight and hotel destinations in
%% student-5), and each info table holds one guide subsection.

erDiagram
    USER ||--o{ ACCESS_LOG : "signs in as"

    USER {
        INTEGER id                          PK "owned by shared-db"
        TEXT    name                            "NOT NULL"
        TEXT    email                       UK  "NOT NULL"
        TEXT    password_hash                   "NOT NULL, werkzeug pbkdf2"
        INTEGER is_validated                    "NOT NULL, default 0"
        TEXT    verification_token              "single-use, cleared once spent"
        TEXT    verification_expires_at         "5 minute TTL"
        TEXT    last_verification_sent_at       "resend 60s gate"
        INTEGER verification_resend_count       "NOT NULL, default 0, max 5"
        TEXT    verification_blocked_until      "10 minute cooldown, then resets"
        TEXT    created_at                      "NOT NULL, ISO 8601"
    }

    ACCESS_LOG {
        INTEGER id          PK
        INTEGER user_id     FK "NOT NULL, references USER"
        TEXT    sign_in_at      "NOT NULL, ISO 8601"
        TEXT    sign_out_at     "nullable, still signed in if NULL"
        INTEGER in_session      "NOT NULL, default 0"
    }

    DESTINATION ||--o| CURRENCY_INFO       : "priced in"
    DESTINATION ||--o{ TRANSPORTATION_INFO : "reachable by"
    DESTINATION ||--o{ VISA_REQUIREMENT    : "entered under"
    DESTINATION ||--o{ WEATHER_INFO        : "experiences"
    DESTINATION ||--o| SAFETY_INFO         : "rated for"

    DESTINATION {
        INTEGER id      PK
        TEXT    country     "NOT NULL, Australia for every seed row"
        TEXT    city        "NOT NULL"
        TEXT    region      "NOT NULL, state or territory"
    }

    CURRENCY_INFO {
        INTEGER id              PK
        INTEGER destination_id  FK "NOT NULL, references DESTINATION"
        TEXT    currency_code      "NOT NULL, e.g. AUD"
        TEXT    currency_name      "NOT NULL"
        TEXT    exchange_tips      "NOT NULL"
    }

    TRANSPORTATION_INFO {
        INTEGER id              PK
        INTEGER destination_id  FK "NOT NULL, references DESTINATION"
        TEXT    type               "NOT NULL, flights, metro, train, taxi or rental"
        TEXT    description        "NOT NULL"
        TEXT    tips               "NOT NULL"
    }

    VISA_REQUIREMENT {
        INTEGER id              PK
        INTEGER destination_id  FK "NOT NULL, references DESTINATION"
        TEXT    nationality        "NOT NULL"
        TEXT    requirement_type   "NOT NULL"
        TEXT    notes              "NOT NULL"
    }

    WEATHER_INFO {
        INTEGER id              PK
        INTEGER destination_id  FK "NOT NULL, references DESTINATION"
        TEXT    month              "NOT NULL, January to December"
        REAL    avg_temp           "NOT NULL, degrees Celsius"
        REAL    rainfall           "NOT NULL, millimetres"
        TEXT    best_visit_time    "NOT NULL"
    }

    SAFETY_INFO {
        INTEGER id              PK
        INTEGER destination_id  FK "NOT NULL, references DESTINATION"
        TEXT    safety_level       "NOT NULL"
        TEXT    tips               "NOT NULL"
    }
