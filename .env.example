# ---------------------------------------------------------------------------
# Group 25 - Travel App - Release 0 environment
# Copy to .env before running docker compose:  cp .env.example .env
# ---------------------------------------------------------------------------

# Ollama runtime.
# Default: Ollama runs on the HOST (already installed), reached from containers
# via host.docker.internal. To run Ollama as a container instead, see README
# section "Running Ollama in a container".
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Approved open-source LLM (Spec 4.1: Llama, Qwen, or DeepSeek).
# qwen2.5:0.5b is the default because the team's dev machines include an 8 GB
# laptop where llama3.1:8b needs a 6.2 GB working set and thrashes swap.
OLLAMA_MODEL=qwen2.5:0.5b

# Larger model used by the agentic loop's review role. Swap to llama3.1:8b on a
# machine with >= 16 GB RAM.
OLLAMA_REVIEW_MODEL=llama3.2:latest

# Shared AI-Mode service, called by every student backend/API.
AI_MODE_URL=http://ai-mode:5300

# Host base URL used by the agentic loop when probing live endpoints.
APP_BASE_URL=http://localhost:8080
