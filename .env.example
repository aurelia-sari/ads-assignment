# ---------------------------------------------------------------------------
# Group 25 - Travel App - Release 0 environment
# Copy to .env before running docker compose:  cp .env.example .env
# ---------------------------------------------------------------------------

# Ollama runtime.
# Default: Ollama runs on the HOST (already installed), reached from containers
# via host.docker.internal. To run Ollama as a container instead, see README
# section "Running Ollama in a container".
# AI-Mode, MCP and RAG run on the HOST in Release 1, so Ollama is plain
# localhost. host.docker.internal only resolves from inside a container.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Approved open-source LLM (Spec 4.1: Llama, Qwen, or DeepSeek).
# llama3.2 (3B, 2.0 GB) is the serving model. qwen2.5:0.5b was tried first and
# is faster, but it invents figures: asked for a distance the data does not
# contain, it produced per-day kilometre values. llama3.2 answers "This
# information is not recorded" to the same question, and still responds in
# 2-8 seconds on the 8 GB machine. llama3.1:8b remains too large - it needs a
# 6.2 GB working set and thrashes swap.
OLLAMA_MODEL=llama3.2:latest

# Larger model used by the agentic loop's review role. Swap to llama3.1:8b on a
# machine with >= 16 GB RAM.
OLLAMA_REVIEW_MODEL=llama3.2:latest

# Shared AI-Mode service, called by every student backend/API.
# The containerised backends reach the host-local AI services the other way
# round, through host.docker.internal. These three are NOT compose services.
AI_MODE_URL=http://host.docker.internal:5300
MCP_SERVER_URL=http://host.docker.internal:5400
RAG_SERVER_URL=http://host.docker.internal:5500

# Host base URL used by the agentic loop when probing live endpoints.
APP_BASE_URL=http://localhost:8080
